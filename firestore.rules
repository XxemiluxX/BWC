rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

   function isConfiguredAdmin() {
  return signedIn()
    && request.auth.token.email != null
    && request.auth.token.email in [
      'mongemoraemiliano60@gmail.com',
      'proyecto.ecracr@gmail.com'
    ];
}
    function isAdmin() {
      return isConfiguredAdmin();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfiles de usuario: lectura pública para mostrar nombres en foros/retos, escritura estricta
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.firebaseUid == uid
        && (request.resource.data.role == 'participant' || isConfiguredAdmin());
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.firebaseUid == resource.data.firebaseUid
          && (request.resource.data.role == resource.data.role || isConfiguredAdmin()));
      allow delete: if isAdmin();
    }

    // Progreso de retos individuales por usuario
    match /user_challenges/{docId} {
      allow read: if true;
      // Un reto solo se marca "completed" tras aprobar una evidencia (foto o video): lo hace el administrador.
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid
            && request.resource.data.status != 'completed');
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
            && resource.data.status != 'completed'
            && request.resource.data.status != 'completed');
      allow delete: if isAdmin();
    }

    // Publicaciones en foros comunitarios
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4;
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid)
        // Permitir incrementar contadores de comentarios y participantes a usuarios autenticados
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'participantsCount', 'updatedAt']));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // Comentarios en publicaciones
    match /forumComments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2;
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // Registros de colaboración y participación en proyectos sostenibles
    match /forumParticipations/{participationId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Reportes comunitarios de contenido problemático
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // Evidencias fotográficas
    match /evidences/{evidenceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // Toda evidencia debe traer su archivo (foto o video) y nace "pending"; solo el admin la aprueba.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.imageURL is string
        && request.resource.data.imageURL.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Trazabilidad y bitácora de actividad
    match /activity/{activityId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
