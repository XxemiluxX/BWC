rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isConfiguredAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'mongemoraemiliano60@gmail.com';
    }
    function isAdmin() { return isConfiguredAdmin(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.firebaseUid == uid
        && (request.resource.data.role == 'participant' || isConfiguredAdmin());
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.completed == resource.data.completed
          && request.resource.data.currentChallenge == resource.data.currentChallenge
          && request.resource.data.firebaseUid == resource.data.firebaseUid);
      allow delete: if isAdmin();
    }


    match /activity/{activityId} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || (signedIn() && request.resource.data.actorUid == request.auth.uid && request.resource.data.type == 'submission'));
      allow update, delete: if false;
    }

    match /evidences/{evidenceId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.challengeNumber >= 1
        && request.resource.data.challengeNumber <= 3
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentChallenge == request.resource.data.challengeNumber;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
